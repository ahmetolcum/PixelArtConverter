<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for notarizing the py2app bundle.

  Python's embedded interpreter and the bundled native wheels (numpy, scipy,
  scikit-image, onnxruntime/rembg) need these to run under the hardened
  runtime that notarization requires:

  - allow-jit / allow-unsigned-executable-memory:
      CPython and some numeric kernels allocate executable memory at runtime.
  - disable-library-validation:
      The bundle loads many .so/.dylib not all signed by our Team ID; without
      this the hardened runtime refuses to load them.
  - allow-dyld-environment-variables:
      py2app's bootstrap relies on DYLD_* to locate the embedded framework.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
